# UNLOOP — environment template. PLACEHOLDERS ONLY. Never commit a filled-in copy.
# Copy to agent/.env.local (agent) and apps/web/.env.local (frontend).
#
# The agent reads these server-side only. RIME_API_KEY must never reach the browser
# bundle: the frontend talks to LiveKit, and only the Python worker talks to Rime.

# ---------------------------------------------------------------------------
# LiveKit Cloud  (https://cloud.livekit.io -> project settings)
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Rime TTS — the judged speech path (direct plugin, not via a gateway)
# ---------------------------------------------------------------------------
RIME_API_KEY=

# Verified against the live catalog at https://users.rime.ai/data/voices/all-v2.json
# Accepted models in livekit-plugins-rime 1.8.0: coda | mistv3 | mistv2   ("arcana" is retired)
RIME_MODEL=coda

# Must exist in the catalog for (RIME_MODEL, RIME_LANGUAGE). Verify with:
#   uv run python ../scripts/verify_rime_catalog.py
RIME_SPEAKER=eyre

# Plugin accepts: eng | spa | fra | ger | hin
RIME_LANGUAGE=eng

# IMPORTANT: ORIGIN ONLY — do NOT append /ws3.
# livekit-plugins-rime builds "{base_url}/ws3?..." itself; including /ws3 here produces
# ".../ws3/ws3?..." and the connection fails.
#   US West (plugin default): wss://users-ws.rime.ai
#   US East:                  wss://users-east-ws.rime.ai
# Pick the region nearest your deployed worker; benchmark with scripts/run_voice_benchmark.py
RIME_BASE_URL=wss://users-ws.rime.ai

# Coda's native rate is 24000. Use 8000 for the telephony/SIP path (Rime recommends
# requesting telephone audio directly rather than resampling downstream).
RIME_SAMPLE_RATE=24000

# WebSocket segmentation: bySentence | immediate | never
RIME_SEGMENT=bySentence

# ---------------------------------------------------------------------------
# STT — LiveKit Inference (no separate provider key needed)
# ---------------------------------------------------------------------------
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=en

# ---------------------------------------------------------------------------
# LLM — provider-agnostic. "inference" uses LiveKit Inference and needs no extra key.
# ---------------------------------------------------------------------------
LLM_PROVIDER=inference
LLM_MODEL=openai/gpt-4.1-mini

# Only needed if LLM_PROVIDER is set to a direct provider plugin instead of "inference".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
# DEMO_MODE=true exposes the scenario / tool-delay controls in the debug panel.
# It only selects deterministic fixtures; it can never script the conversation.
DEMO_MODE=true
LOG_LEVEL=INFO

# Directory for machine-generated evidence (events jsonl, results.json, rime_config.json)
UNLOOP_ARTIFACTS_DIR=../artifacts
