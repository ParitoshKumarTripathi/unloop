# UNLOOP frontend — PLACEHOLDERS ONLY. Copy to .env.local and fill in.
#
# Only LiveKit credentials belong here, and none of them carry a NEXT_PUBLIC_ prefix,
# so they stay server-side in the token route and never reach the browser bundle.
#
# RIME_API_KEY is deliberately NOT here. The browser never talks to Rime; only the
# Python worker does. scripts/preflight.sh fails if RIME_API_KEY ever appears under
# apps/web.

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
#
# The UNLOOP worker registers as @server.rtc_session(agent_name="unloop"), which means
# EXPLICIT dispatch. This MUST be set to "unloop" — leaving it blank selects automatic
# dispatch and no agent will ever join the room.
AGENT_NAME=unloop

# Set to "false" to hide the fixture/tool-delay controls in the resolution panel.
# They only set fixture conditions; they cannot script the conversation.
DEMO_MODE=true
